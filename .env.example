VITE_API_M1_URL=http://localhost:8081
VITE_API_M2_URL=http://localhost:8082
# M3 (finanzas) va por el proxy de Vite porque el backend no publica CORS:
# el mismo origen /api/m3 se redirige a http://localhost:8080 (vite.config.js).
VITE_API_M3_URL=/api/m3
# Propietario declarado para el alcance OWNER (temporal, hasta que exista autenticación).
# Debe ser un UUID válido y coincidir con el owner_id de los eventos de reservas (M2);
# sin él, las pantallas de propietario reportan error de configuración en vez de consultar.
VITE_M3_OWNER_ID=a1b2c3d4-e5f6-4a5b-8c9d-0e1f2a3b4c5d

# Public Key de PRUEBAS de una aplicación MercadoPago de Colombia (MCO).
# Nunca incluir Access Token ni secreto del webhook en variables VITE_*.
VITE_MERCADOPAGO_PUBLIC_KEY=TEST-4608c7f1-f171-48b1-886f-2aaebffff815
