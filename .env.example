# Desarrollo contra los servicios desplegados, sin CORS en el navegador.
# ATENCIÓN: las acciones de la interfaz modifican datos reales.
VITE_API_M1_URL=/api/m1
VITE_API_M2_URL=/api/m2
VITE_API_M3_URL=/api/m3
M1_PROXY_TARGET=https://sea-share-frontend.vercel.app/api/m1
M2_PROXY_TARGET=https://sea-share-frontend.vercel.app/api/m2
M3_PROXY_TARGET=https://sea-share-frontend.vercel.app/api/m3
# Para probar cambios de backend localmente, cambia el destino correspondiente:
# M2_PROXY_TARGET=http://localhost:8080
# Propietario declarado para el alcance OWNER (temporal, hasta que exista autenticación).
# Debe ser un UUID válido y coincidir con el owner_id de los eventos de reservas (M2);
# sin él, las pantallas de propietario reportan error de configuración en vez de consultar.
VITE_M3_OWNER_ID=a1b2c3d4-e5f6-4a5b-8c9d-0e1f2a3b4c5d

# Public Key de PRUEBAS de una aplicación MercadoPago de Colombia (MCO).
# Nunca incluir Access Token ni secreto del webhook en variables VITE_*.
VITE_MERCADOPAGO_PUBLIC_KEY=
